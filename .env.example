# ─────────────────────────────────────────────────
# ChasteAI — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# pnpm will automatically load .env files.

# ── Database ─────────────────────────────────────
# PostgreSQL (production/cloud)
DATABASE_URL="postgres://postgres:password@localhost:5432/chasteai"
# Turso/SQLite (local/self-host)
# TURSO_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# ── Auth ─────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI Providers ─────────────────────────────────
# At least one provider is required. Supported: OpenAI, Groq, Anthropic.
OPENAI_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."
# ANTHROPIC_API_KEY="sk-ant-..."
# OLLAMA_BASE_URL="http://localhost:11434"

# ── Storage ──────────────────────────────────────
# S3-compatible or Cloudflare R2
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="chasteai"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
# Use local filesystem instead:
# STORAGE_LOCAL_PATH="./data/storage"

# ── Queue ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Billing ──────────────────────────────────────
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# LEMON_SQUEEZY_API_KEY="..."

# ── Email ────────────────────────────────────────
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# ── App ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WIDGET_URL="http://localhost:3000/widget"
