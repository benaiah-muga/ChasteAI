{
  "name": "chaste-ai",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:browser": "agent-browser open http://localhost:3000/signin && agent-browser snapshot -i",
    "test:browser:auth": "agent-browser open http://localhost:3000/signin && agent-browser fill '@e2' 'admin@chasteai.dev' && agent-browser fill '@e4' 'password123' && agent-browser click '@e5' && agent-browser snapshot",
    "test:browser:install": "agent-browser install",
    "setup": "bash scripts/setup.sh",
    "setup:db": "tsx scripts/setup-tui.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @chaste-ai/db db:generate",
    "db:migrate": "pnpm --filter @chaste-ai/db db:migrate",
    "db:studio": "pnpm --filter @chaste-ai/db db:studio",
    "db:seed": "pnpm --filter @chaste-ai/db db:seed",
    "adr:create": "bash scripts/adr-create.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chaste-ai/eslint-config": "workspace:*",
    "@chaste-ai/prettier-config": "workspace:*",
    "@chaste-ai/typescript-config": "workspace:*",
    "@clack/prompts": "^1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
